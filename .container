  width: 100%; display: flex; flex-direction: column; gap: 1.5rem; 
  animation: fadeInUp 0.5s ease-out;
}
.displayArea { display: flex; justify-content: space-between; 
  align-items: center; padding: 1.5rem; border-radius: 12px; 
  word-break: break-all;
}
.passwordText { font-size: 1.2rem; font-weight: 600; font-family: 
  monospace; letter-spacing: 1px; color: var(--accent-color);
}
.copyBtn { background: var(--accent-color); color: var(--bg-dark); 
  border: none; padding: 0.5rem 1rem; border-radius: 8px; cursor: 
  pointer; font-weight: 700; white-space: nowrap; margin-left: 1rem; 
  transition: var(--transition);
}
.copyBtn:hover { transform: translateY(-2px);
}
.strengthBar { width: 100%; height: 6px; background: var(--glass-bg); 
  border-radius: 10px; overflow: hidden;
}
.strengthFill { height: 100%; transition: width 0.3s ease, 
  background-color 0.3s ease; border-radius: 10px;
}
.strengthText { text-align: right; font-size: 0.85rem; font-weight: 
  600; margin-top: -0.5rem;
}
.controls { padding: 2rem; display: flex; flex-direction: column; gap: 
  1.5rem;
}
.controlRow { display: flex; flex-direction: column; gap: 0.5rem;
}
.controlRow label { font-weight: 600; font-size: 1rem;
}
.lengthVal { color: var(--accent-color); font-weight: 800;
}
.clueInput { width: 100%; padding: 0.8rem 1rem; background: 
  var(--glass-bg); border: 1px solid var(--glass-border); 
  border-radius: 8px; color: var(--text-dark); font-size: 1rem; 
  outline: none; font-family: inherit; transition: var(--transition);
}
.clueInput:focus { border-color: var(--accent-color); box-shadow: 0 0 0 
  3px rgba(0, 129, 112, 0.2); /* subtle teal glow */
}
.clueInput::placeholder { color: var(--text-dark); opacity: 0.4;
}
.slider { -webkit-appearance: none; width: 100%; height: 8px; 
  background: var(--glass-bg); border-radius: 5px; outline: none;
}
.slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: 
  none; width: 20px; height: 20px; border-radius: 50%; background: 
  var(--accent-color); cursor: pointer; border: 2px solid 
  var(--bg-dark);
}
.checkboxGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 
  1rem;
}
.checkboxLabel { display: flex; align-items: center; gap: 0.5rem; 
  font-size: 0.95rem; cursor: pointer;
}
.checkboxLabel input { width: 18px; height: 18px; accent-color: 
  var(--accent-color); cursor: pointer;
}
.generateBtn { background: var(--primary-gradient); color: white; 
  border: none; padding: 1rem; border-radius: 12px; font-size: 1.1rem; 
  font-weight: 700; cursor: pointer; transition: var(--transition);
}
.generateBtn:hover { transform: translateY(-3px); box-shadow: 0 10px 
  20px rgba(0, 0, 0, 0.2);
}
/* Responsive */ @media (max-width: 600px) { .checkboxGrid { 
    grid-template-columns: 1fr;
  }
  .displayArea { flex-direction: column; text-align: center; gap: 1rem;
  }
  .copyBtn { margin-left: 0; width: 100%;
  }
}
